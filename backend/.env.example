# Copy to .env and adjust. Every setting is optional; defaults run locally with zero setup.
# Variable names are case-insensitive and map 1:1 to app/core/config.py.

# local | test | staging | production
ENV=local
DEBUG=false
LOG_LEVEL=INFO

# Public base URL of this API. Used to build absolute URLs such as local upload targets.
PUBLIC_BASE_URL=http://localhost:8000

# --- Database ---------------------------------------------------------------
# Default (unset): SQLite file at backend/var/shortcraft.db
# docker-compose Postgres:
#   DATABASE_URL=postgresql+asyncpg://shortcraft:shortcraft@localhost:5432/shortcraft
# Supabase (use the pooler/session connection string, swap the scheme to postgresql+asyncpg):
#   DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=
DATABASE_ECHO=false

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000

# --- Storage ----------------------------------------------------------------
# local | r2   (r2 is a stub: not implemented yet)
STORAGE_BACKEND=local
# Default (unset): backend/var/uploads
# LOCAL_STORAGE_DIR=
# Max upload size in bytes (default 1 GiB).
MAX_UPLOAD_BYTES=1073741824

# Cloudflare R2 (used once the R2 adapter exists)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# --- Jobs -------------------------------------------------------------------
# inprocess (no-op: jobs stay "queued"). arq + Redis comes later.
JOB_QUEUE_BACKEND=inprocess
REDIS_URL=redis://localhost:6379/0

# --- Third-party APIs (unused until agents / transcription land) ------------
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
