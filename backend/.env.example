# Copy to backend/.env and fill in. Never commit .env (it is in .gitignore).
# Every setting is optional: with nothing set, the API uses SQLite + local disk (tests and CI
# always do). Names are case-insensitive and map 1:1 to app/core/config.py.
# Step-by-step guide for Supabase + Cloudflare R2: docs/SETUP.md

# =============================================================================
# App
# =============================================================================
# local | test | staging | production
ENV=local
DEBUG=false
LOG_LEVEL=INFO
# Public base URL of this API (used to build local upload/playback URLs).
PUBLIC_BASE_URL=http://localhost:8000
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# Database — Supabase Postgres
# =============================================================================
# Empty = SQLite file at backend/var/shortcraft.db.
# Supabase: Project > Connect > "Session pooler" string. Change the start to
# postgresql+asyncpg:// (plain postgresql:// also works; it is converted).
# If the password has special characters (@ : / # ?), URL-encode them.
#   DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Transaction pooler (port 6543) also works: prepared statements are turned off automatically.
# SSL is required on Supabase and added automatically (or add ?sslmode=require).
# docker-compose Postgres:
#   DATABASE_URL=postgresql+asyncpg://shortcraft:shortcraft@localhost:5432/shortcraft
DATABASE_URL=
# Optional: a different URL only for `alembic` migrations (direct or session connection).
DATABASE_URL_MIGRATIONS=
# Log every SQL statement.
DATABASE_ECHO=false

# =============================================================================
# Storage — Cloudflare R2 (S3-compatible)
# =============================================================================
# local = files on disk in backend/var/uploads (default)   r2 = Cloudflare R2
STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=
# Biggest allowed upload in bytes (default 2 GiB = 2147483648, hard max 5 GiB).
MAX_UPLOAD_BYTES=2147483648
# Files bigger than this use multipart upload (default 100 MiB), in parts of this size (10 MiB).
# MULTIPART_THRESHOLD_BYTES=104857600
# MULTIPART_PART_SIZE_BYTES=10485760
# Lifetime of presigned URLs in seconds: uploads (default 3 h) and playback/download (1 h).
# UPLOAD_URL_TTL_SECONDS=10800
# DOWNLOAD_URL_TTL_SECONDS=3600

# Cloudflare dashboard > R2 > Overview: "Account ID" (right side).
R2_ACCOUNT_ID=
# Bucket name, e.g. shortcraft-dev
R2_BUCKET=
# R2 > Manage API tokens > Create token (Object Read & Write, this bucket only).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public/custom domain of the bucket. Leave empty to keep videos private
# (the API then gives short-lived presigned links).
R2_PUBLIC_BASE_URL=
# Optional: override the S3 endpoint. Default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=

# =============================================================================
# Auth — Supabase (prepared, not enforced yet)
# =============================================================================
# false = anonymous requests allowed. A token that is sent must still be valid.
AUTH_REQUIRED=false
# Project > Settings > API: Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Only for the legacy HS256 secret (Project > Settings > JWT Keys > Legacy JWT secret).
# Empty = use the public JWKS (asymmetric signing keys) from SUPABASE_URL.
SUPABASE_JWT_SECRET=
# Optional override. Default: <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_AUDIENCE=authenticated

# =============================================================================
# Jobs
# =============================================================================
# inprocess (no-op: jobs stay "queued"). arq + Redis comes later.
JOB_QUEUE_BACKEND=inprocess
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AI / third-party keys (later: agents, transcription)
# =============================================================================
# AI provider: OpenAI only (via LangChain + LangGraph).
# Get a key: platform.openai.com > API keys > Create new secret key.
OPENAI_API_KEY=
# Default chat model id, e.g. a current GPT model. Check the exact id in OpenAI's docs.
OPENAI_MODEL_DEFAULT=
# Optional agent tracing with LangSmith (smith.langchain.com > Settings > API keys).
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# Speech to text.
DEEPGRAM_API_KEY=
