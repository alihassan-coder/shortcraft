# Copy to backend/.env and fill in. Never commit .env (it is in .gitignore).
# Every setting is optional: with nothing set, the API uses SQLite + local disk (tests and CI
# always do). Names are case-insensitive and map 1:1 to app/core/config.py.
# Step-by-step guide for Supabase + Cloudflare R2: docs/SETUP.md

# =============================================================================
# App
# =============================================================================
# local | test | staging | production
ENV=local
DEBUG=false
LOG_LEVEL=INFO
# Public base URL of this API (used to build local upload/playback URLs).
PUBLIC_BASE_URL=http://localhost:8000
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# Database — Supabase Postgres
# =============================================================================
# Empty = SQLite file at backend/var/shortcraft.db.
# Supabase: Project > Connect > "Session pooler" string. Change the start to
# postgresql+asyncpg:// (plain postgresql:// also works; it is converted).
# If the password has special characters (@ : / # ?), URL-encode them.
#   DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Transaction pooler (port 6543) also works: prepared statements are turned off automatically.
# SSL is required on Supabase and added automatically (or add ?sslmode=require).
# docker-compose Postgres:
#   DATABASE_URL=postgresql+asyncpg://shortcraft:shortcraft@localhost:5432/shortcraft
DATABASE_URL=
# Optional: a different URL only for `alembic` migrations (direct or session connection).
DATABASE_URL_MIGRATIONS=
# Log every SQL statement.
DATABASE_ECHO=false

# =============================================================================
# Storage — Cloudflare R2 (S3-compatible)
# =============================================================================
# local = files on disk in backend/var/uploads (default)   r2 = Cloudflare R2
STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=
# Biggest allowed upload in bytes (default 2 GiB = 2147483648, hard max 5 GiB).
MAX_UPLOAD_BYTES=2147483648
# Files bigger than this use multipart upload (default 100 MiB), in parts of this size (10 MiB).
# MULTIPART_THRESHOLD_BYTES=104857600
# MULTIPART_PART_SIZE_BYTES=10485760
# Lifetime of presigned URLs in seconds: uploads (default 3 h) and playback/download (1 h).
# UPLOAD_URL_TTL_SECONDS=10800
# DOWNLOAD_URL_TTL_SECONDS=3600

# Cloudflare dashboard > R2 > Overview: "Account ID" (right side).
R2_ACCOUNT_ID=
# Bucket name, e.g. shortcraft-dev
R2_BUCKET=
# R2 > Manage API tokens > Create token (Object Read & Write, this bucket only).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public/custom domain of the bucket. Leave empty to keep videos private
# (the API then gives short-lived presigned links).
R2_PUBLIC_BASE_URL=
# Optional: override the S3 endpoint. Default: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=

# =============================================================================
# Auth — Supabase (prepared, not enforced yet)
# =============================================================================
# false = anonymous requests allowed. A token that is sent must still be valid.
AUTH_REQUIRED=false
# Project > Settings > API: Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Only for the legacy HS256 secret (Project > Settings > JWT Keys > Legacy JWT secret).
# Empty = use the public JWKS (asymmetric signing keys) from SUPABASE_URL.
SUPABASE_JWT_SECRET=
# Optional override. Default: <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_AUDIENCE=authenticated

# =============================================================================
# Jobs / worker
# =============================================================================
# auto (default): arq + Redis when REDIS_URL is set, otherwise jobs run in-process (asyncio
# tasks inside the API; fine for dev, lost if the API restarts).
# inprocess | arq force one or the other.
JOB_QUEUE_BACKEND=auto
# Empty = no Redis. docker-compose Redis: redis://localhost:6379/0
# With Redis, also run the worker: uv run arq app.worker.main.WorkerSettings
REDIS_URL=
# Jobs running at once per process, and the time limit of one job (seconds).
# WORKER_CONCURRENCY=2
# JOB_TIMEOUT_SECONDS=3600
# Make the 720p proxy, audio, thumbnails and waveform right after each upload.
PROXY_ON_UPLOAD=true

# =============================================================================
# Media (ffmpeg)
# =============================================================================
# Names on PATH or full paths, e.g. C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Scratch dir for media jobs (originals are copied here while processing). Empty = system temp.
WORK_DIR=

# =============================================================================
# AI agents (OpenAI only, via LangChain + LangGraph)
# =============================================================================
# Get a key: platform.openai.com > API keys > Create new secret key.
# Without a key: plan jobs in mode "ai" save the basic edit (with a warning) and
# POST /plan/edit answers 503.
OPENAI_API_KEY=
# Model ids (checked 2026-10-24 on developers.openai.com/api/docs/models + /pricing):
#   gpt-6-astra  most capable           $10 / $50 per 1M tokens in/out
#   gpt-6.1-sol  near-Astra, cheaper    $2 / $10
#   gpt-6-luna   most efficient         $0.10 / $0.50
# Default for every agent without its own setting.
OPENAI_MODEL_DEFAULT=gpt-6.1-sol
# Per agent. Empty = OPENAI_MODEL_DEFAULT. Caption, hook and music default to gpt-6-luna.
# AGENT_MODEL_DIRECTOR=
# AGENT_MODEL_CUT=
# AGENT_MODEL_ZOOM=
# AGENT_MODEL_EDIT=
# AGENT_MODEL_CAPTION=gpt-6-luna
# AGENT_MODEL_HOOK=gpt-6-luna
# AGENT_MODEL_MUSIC=gpt-6-luna
# Second model tried when a call fails (empty = no fallback), e.g. gpt-6-luna.
AGENT_MODEL_FALLBACK=
# Plan jobs chained after transcription use the agents (mode "ai").
AI_PLAN_ENABLED=true
# Per model call: time limit (seconds) and retries with backoff.
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
# "Describe a change" rate limit per project (in-memory token bucket, per API process).
AI_EDIT_BURST=5
AI_EDIT_PER_MINUTE=10
# Optional agent tracing with LangSmith (smith.langchain.com > Settings > API keys).
# Copied into the LANGSMITH_* environment variables LangChain reads.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=shortcraft
# Only outside the US region, e.g. https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=

# =============================================================================
# Speech to text
# =============================================================================
# Speech to text (Deepgram). Get a key: console.deepgram.com > API Keys.
DEEPGRAM_API_KEY=

# =============================================================================
# Transcription (A1) and the first edit without AI (A2)
# =============================================================================
# auto (default): Deepgram when DEEPGRAM_API_KEY is set, otherwise an offline fake that
# returns a fixed demo script (dev/tests only, not real speech). deepgram | fake force one.
TRANSCRIPTION_PROVIDER=auto
# Deepgram pre-recorded model; nova-3 is Deepgram's current general Nova model.
DEEPGRAM_MODEL=nova-3
# Default spoken language (BCP-47). Deepgram's filler words (um/uh) are English only.
# TRANSCRIPTION_LANGUAGE=en
# Request time limit for one Deepgram call (seconds).
# DEEPGRAM_TIMEOUT_SECONDS=300
# After the proxy job: transcribe automatically (only when the video has audio).
TRANSCRIBE_ON_UPLOAD=true
# After transcription: build the basic edit (silences, fillers, retakes cut; captions,
# zooms, hook, music) and save it as the next plan revision.
AUTO_PLAN=true
# ffmpeg silencedetect: quieter than SILENCE_NOISE_DB (dB) for at least SILENCE_MIN_S
# seconds counts as silence.
SILENCE_NOISE_DB=-35
SILENCE_MIN_S=0.35
# Gaps between words longer than this (ms) are cut as silence too.
MIN_PAUSE_MS=400
# Air kept next to speech on each side of a silence cut (ms), so no word gets clipped.
CUT_PADDING_MS=120
